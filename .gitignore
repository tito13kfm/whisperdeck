.venv/
__pycache__/
*.pyc
data/
run_out.log
.superpowers/
run_err.log
test.mp4
test_audio.mp3
.claude/*
!.claude/skills/
!.claude/skills/**
!.claude/commands/
!.claude/commands/**
!.claude/issue-runner-prompt.md
.serena/
*.log
dist/
scripts/.build-cache/
.playwright-mcp/
tests/fixtures/

# Node.js dependencies (esbuild for the frontend build step)
node_modules/

# Local secrets / machine-specific (keep out of git)
scripts/cookies.txt
scripts/providers_backup.json

# UX-audit runtime artifacts (PID file, local config, one-off setup scripts)
scripts/ux_audit_*
scripts/provider_local.json
scripts/settings_payload.json

# OpenCode project-level config (agents use global ~/.config/opencode/agents/).
# `.opencode/*` rather than `.opencode/`, because git cannot re-include a file
# whose parent directory is itself excluded: the old `!.opencode/oh-my-openagent.jsonc`
# line never took effect, and nothing under this directory was ever tracked.
# oh-my-openagent.jsonc stays untracked on purpose (it is a local per-machine
# override and says so in its own header). `command/issue.md` is tracked,
# same reasoning as `.omo/issue-runner-prompt.md` below: it pins which agent
# orchestrates a /issue run, and a run that silently used whatever agent the
# session had selected produced a PR audited by the model that wrote it.
.opencode/*
!.opencode/command/
.opencode/command/*
!.opencode/command/issue.md

# Local verification and audit scratch space
.local/
.audit-worktrees/

# oh-my-openagent (OpenCode) runtime state: session-continuation blobs and
# working plan docs, machine-local like .opencode/ above.
# Exception: the issue-runner prompt is tracked. It drives most of the agent
# runs on this repo and used to have no history at all, so a bad edit could
# not be reverted or bisected, changes never passed review, and a fresh clone
# didn't have it while its Claude Code counterpart shipped with the repo.
# Everything else under .omo/ (runs/, plans/, drafts/, session state) stays
# local. Trailing /* rather than / so git descends far enough to see the
# negation below.
.omo/*
!.omo/issue-runner-prompt.md

# task-observer tool output, retiring, never produced a skill
skill-observations/
