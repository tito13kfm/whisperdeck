{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",

  // Keep all agents, just configure models
  "telemetry": false,
  "tmux": { "enabled": false },
  "team_mode": { "enabled": false },
  "goal": { "enabled": false },

  "disabled_hooks": [
    "openclaw", "goal", "monitor", "start-work", "handoff"
  ],

  "agents": {
    "sisyphus": {
      "model": "cline-pass/deepseek-v4-pro"
    },
    "hephaestus": {
      "model": "openrouter/deepseek/deepseek-v4-pro"
    },
    "prometheus": {
      "model": "openrouter/deepseek/deepseek-v4-pro"
    },
    "explore": {
      "model": "openrouter/qwen/qwen3-coder-30b-a3b-instruct"
    },
    "sisyphus-junior": {
      "model": "openrouter/deepseek/deepseek-v4-flash"
    }
  },

  "categories": {
    "quick": {
      "model": "openrouter/qwen/qwen3-coder-30b-a3b-instruct"
    },
    "visual-engineering": {
      "model": "openrouter/qwen/qwen3-coder-30b-a3b-instruct"
    },
    "deep": {
      "model": "openrouter/deepseek/deepseek-v4-pro"
    },
    "ultrabrain": {
      "model": "openrouter/deepseek/deepseek-v4-pro"
    },
    "writing": {
      "model": "openrouter/qwen/qwen3-coder-30b-a3b-instruct"
    }
  }
}
